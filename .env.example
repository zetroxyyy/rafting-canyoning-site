# ─── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — runtime pooler (pgbouncer). Used by the Prisma client
# at runtime. Obtain from Supabase Dashboard → Project → Settings → Database → Connection string → Transaction mode.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true

# Supabase PostgreSQL — direct connection. Used by Prisma migrations (no pgbouncer).
# Obtain from Supabase Dashboard → Project → Settings → Database → Connection string → Session mode.
DIRECT_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Supabase Storage ────────────────────────────────────────────────────────
# Supabase project URL — used for Storage (PDF hosting) and auth.
# Found in Supabase Dashboard → Project → Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Service Role key — server-side only. Never expose to the browser.
# Found in Supabase Dashboard → Project → Settings → API → Service role secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Admin Authentication (next-auth v5) ─────────────────────────────────────
# The AUTH_SECRET is automatically read by next-auth v5.
# Generate a secure value with: openssl rand -hex 32
AUTH_SECRET=replace-with-32-byte-random-hex

# Fallback plain-text admin password (used for admin accounts that have no
# bcrypt hash stored in the DB). Set a strong value; rotate it regularly.
ADMIN_PASSWORD=change-me-before-going-live

# ─── Email — Resend ──────────────────────────────────────────────────────────
# Resend API key for transactional emails (booking confirmations, refund notices).
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Notifications — LINE ────────────────────────────────────────────────────
# LINE Messaging API — channel access token (long-lived).
# Obtain from https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# LINE User ID of the admin account that receives booking notifications.
# Send a message to the bot and query the webhook to find your userId.
LINE_ADMIN_USER_ID=U0000000000000000000000000000000

# ─── Notifications — WhatsApp (Meta Cloud API) ───────────────────────────────
# WhatsApp Cloud API key.
WHATSAPP_API_KEY=your-whatsapp-api-key

# WhatsApp phone number ID (the sending number registered in Meta Business).
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# WhatsApp admin recipient phone in E.164 without the "+" (e.g., 819012345678).
WHATSAPP_ADMIN_PHONE=819000000000

# ─── Google Places (Reviews widget) ─────────────────────────────────────────
# Google Places API key — used to fetch reviews for the testimonials widget.
GOOGLE_PLACES_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Google Place ID for Dream Adventure's Google Business Profile listing.
GOOGLE_PLACE_ID=your-google-place-id

# Direct link to the Google review submission page for this business.
GOOGLE_REVIEW_URL=https://g.page/r/XXXXXXXX/review

# ─── Product IDs (Stripe — legacy, kept for stub compatibility) ──────────────
# NOTE: Stripe Checkout is no longer in use. Payment is collected offline
# (cash / card terminal on-site, or bank transfer). These variables are read
# by a backward-compatible stub and have no active effect on bookings.
NEXT_PUBLIC_RAFTING_PRODUCT_ID=prod_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CANYONING_PRODUCT_ID=prod_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Application ─────────────────────────────────────────────────────────────
# Public base URL of the deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=https://thedreamadventure.com

# ─── Kill Switches ───────────────────────────────────────────────────────────
# See README.md → "Kill Switches" for full documentation.

# NEXT_PUBLIC_GRAND_OPENING_SOON — controls the public-site blockade (rendered
# in src/app/[locale]/layout.tsx on the server side).
#   "true"  → blockade shown (safe default — site is hidden from visitors)
#   "false" → live site served to all visitors
NEXT_PUBLIC_GRAND_OPENING_SOON=true

# GRAND_OPENING_SOON — controls the server-side booking gate (src/lib/maintenance.ts).
#   "true"  → bookings blocked at the API layer (safe default)
#   "false" → public booking accepted
GRAND_OPENING_SOON=true

# ─── Cron Security ───────────────────────────────────────────────────────────
# Secret sent in the Authorization header by the Vercel cron scheduler.
# Must match the value configured in vercel.json / Vercel Dashboard → Cron Jobs.
CRON_SECRET=replace-with-a-random-secret
