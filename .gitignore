# Dependencies
node_modules

# Next.js build output
.next/
out/
build/

# Environment files — never commit real secrets
.env
.env*.local
# Allow the example file to be committed
!.env.example

# macOS metadata
.DS_Store

# TypeScript build info
*.tsbuildinfo

# Vercel deployment metadata
.vercel

# IDEs
.idea/
.vscode/

# Prisma generated client (re-generated by `prisma generate` on install)
/src/generated/prisma

# Coverage reports
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
